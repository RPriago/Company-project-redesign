# Docker/local development. Export variables or put a separate .env in backend
# when running go run . from backend; root .env is loaded by Docker Compose.
APP_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api
ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=
# Set a unique secret before selecting APP_ENV=production.
DB_TYPE=sqlite
# Production requires a fresh Neon PostgreSQL database and a unique JWT_SECRET.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Alternative local PostgreSQL settings:
DB_PORT=5432
DB_SSLMODE=require
